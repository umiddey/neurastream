#!/usr/bin/env python3
"""oc-run <Agent> -- [KEY=VAL ...] <command ...>
Runs an OpenCode worker (e.g. `PLAN=... OPENCODE_CONFIG_CONTENT=... timeout 3500 opencode run -m <model> "..."`),
passes its output through, and logs agent, model, plan, start/end, exit and whether it ended with a final message
to ~/.local/state/agent-score/oc-runs.jsonl for agent-score (agent-ledger cannot see OpenCode runs)."""
import json, os, subprocess, sys, time

if len(sys.argv) < 4 or sys.argv[2] != "--":
    sys.exit(__doc__)
agent, cmd = sys.argv[1], sys.argv[3:]
env = dict(os.environ)
while cmd and "=" in cmd[0] and not cmd[0].startswith("-") and cmd[0].split("=", 1)[0].isidentifier():
    k, v = cmd.pop(0).split("=", 1)
    env[k] = v
if not cmd:
    sys.exit("no command")
model = cmd[cmd.index("-m") + 1] if "-m" in cmd and cmd.index("-m") + 1 < len(cmd) else "?"
model = model if model.startswith("opencode") else "opencode/" + model
log = os.path.expanduser("~/.local/state/agent-score/oc-runs.jsonl")
os.makedirs(os.path.dirname(log), exist_ok=True)
rec = {"agent": agent, "model": model, "plan": env.get("PLAN", ""), "cwd": os.getcwd(), "start": time.time()}
with open(log, "a") as f:
    f.write(json.dumps(rec) + "\n")
tail = []
p = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
for line in p.stdout:
    sys.stdout.write(line)
    sys.stdout.flush()
    tail = (tail + [line])[-40:]
code = p.wait()
text = "".join(tail).strip()
rec.update(end=time.time(), exit=code, final=bool(text) and code == 0, tail=text[-600:])
# rewrite: replace this run's start record with the finished one
lines = [l for l in open(log) if l.strip()]
with open(log, "w") as f:
    for l in lines:
        r = json.loads(l)
        f.write(json.dumps(rec if (r["agent"], r["start"]) == (agent, rec["start"]) else r) + "\n")
sys.exit(code)
