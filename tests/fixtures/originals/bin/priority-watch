#!/usr/bin/env bash
# Run as a background job (timeout 0). Exits, and so wakes Main, when no agent for the
# owner-queue Priority-agent has been running for two checks in a row (~2-4 min).
while true; do
  if ~/.local/bin/agent-ledger --cap 2>/dev/null | grep -q "^PRIORITY IDLE"; then
    sleep 120
    out=$(~/.local/bin/agent-ledger --cap 2>/dev/null | grep "^PRIORITY IDLE")
    [ -n "$out" ] && { date '+%H:%M'; echo "$out"; exit 0; }
  fi
  sleep 120
done
