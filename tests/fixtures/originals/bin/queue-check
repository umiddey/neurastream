#!/usr/bin/env bun
// queue-check: the whole queue in one read (model: ~/.omp/agent/queue/lib.ts).
// Prints every repo in ~/.omp/agent/INDEX.md with the plans its INDEX.md lists, then every problem;
// exit 1 if any problem. Problems: plan missing or not matching ~/.omp/agent/queue/TEMPLATE.md, missing
// blocker script, plan says complete but is still indexed, repo listed with no plans, repo with plans
// but not listed, repo INDEX.md tracked by git or not excluded.
// Usage: queue-check                 full report
//        queue-check --priority-ids  PRIORITY-ID of every open, non-waiting plan (one per line)
import { execFileSync } from "node:child_process";
import { readdirSync } from "node:fs";
import os from "node:os";
import path from "node:path";
import { activePlans, queueProblems, queueSummary, readIndex, readPlans, REPO_INDEX } from "/home/ukd/.omp/agent/queue/lib.ts";

if (process.argv.includes("--priority-ids")) {
	for (const p of activePlans()) if (p.priorityId && !p.waiting && p.status === "open") console.log(p.priorityId);
	process.exit(0);
}

function git(repo: string, ...args: string[]): boolean {
	try {
		execFileSync("git", ["-C", repo, ...args], { stdio: "ignore" });
		return true;
	} catch {
		return false;
	}
}

const index = readIndex();
const extra: string[] = [];
for (const repo of index) {
	if (!git(repo, "rev-parse", "--git-dir")) continue;
	if (git(repo, "ls-files", "--error-unmatch", REPO_INDEX))
		extra.push(`${repo}: ${REPO_INDEX} is tracked by git; it never goes into git (git rm --cached ${REPO_INDEX})`);
	else if (!git(repo, "check-ignore", "-q", "--no-index", REPO_INDEX))
		extra.push(`${repo}: ${REPO_INDEX} is not git-ignored; add "/${REPO_INDEX}" to ${repo}/.git/info/exclude`);
}
for (const root of [`${os.homedir()}/Work`, `${os.homedir()}/projects`]) {
	let dirs: string[] = [];
	try {
		dirs = readdirSync(root);
	} catch {}
	for (const d of dirs) {
		const repo = path.join(root, d);
		if (!index.includes(repo) && readPlans(repo).length)
			extra.push(`${repo}: ${REPO_INDEX} lists plans but the repo is not in the main index (add it, or empty the repo index)`);
	}
}
console.log(queueSummary());
if (extra.length) console.log(`More problems:\n${extra.map(e => `  - ${e}`).join("\n")}`);
process.exit(queueProblems().length || extra.length ? 1 : 0);
