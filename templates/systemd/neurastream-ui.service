# User unit for the owner's phone page (neurastream ui). `neurastream ui on --login <email>`
# copies this into ~/.config/systemd/user/ and enables + restarts it; `neurastream ui off`
# stops and disables it. Agents never install or start it — that is the owner's move, refused
# by the guards.

[Unit]
Description=neurastream owner page (neurastream ui)
After=network-online.target

[Service]
ExecStart=%h/.bun/bin/neurastream ui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
