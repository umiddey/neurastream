{
  "name": "neurastream",
  "version": "0.2.2",
  "description": "Guardrails for running many AI coding agents at once: plan queue, blockers, call budgets, provider caps, scoring, merge-verified close.",
  "keywords": ["ai-agents", "coding-agents", "orchestration", "guardrails", "omp", "bun", "cli"],
  "homepage": "https://github.com/umiddey/neurastream#readme",
  "bugs": "https://github.com/umiddey/neurastream/issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/neurastream.git"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "blockers",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "neurastream": "src/cli/main.ts",
    "agent-score": "bin/agent-score",
    "agent-ledger": "bin/agent-ledger",
    "brief-lint": "bin/brief-lint",
    "oc-run": "bin/oc-run",
    "wip-check": "bin/wip-check",
    "wip-backup": "bin/wip-backup",
    "wip-snapshot": "bin/wip-snapshot",
    "main-health": "bin/main-health",
    "queue-check": "bin/queue-check",
    "queue-trim": "bin/queue-trim",
    "queue-close": "bin/queue-close",
    "queue-cancel": "bin/queue-cancel",
    "main-start": "bin/main-start",
    "machine-guard": "bin/machine-guard",
    "quota-reset": "bin/quota-reset",
    "priority-watch": "bin/priority-watch",
    "resource-alerts": "bin/resource-alerts",
    "tmp-snapshot": "bin/tmp-snapshot",
    "heavy-run": "bin/heavy-run"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "omp": {
    "extensions": [
      "./src/adapters/omp/index.ts"
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
